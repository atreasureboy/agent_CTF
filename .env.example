# ovolv999 配置文件
# 复制为 .env 并填入你的 API Key

# ── 必填 ──
OPENAI_API_KEY=sk-your-key-here

# ── 可选 ──
# OPENAI_BASE_URL=https://your-proxy.com/v1
# OVOGO_MODEL=claude-sonnet-4-6
# OVOGO_MAX_ITER=200
# OVOGO_MAX_ITERATIONS=200
# OVOGO_MAX_CONCURRENCY=4
# OVOGO_SHELL=bash
# OVOGO_TEMPERATURE=0
# OVOGO_MAX_OUTPUT_TOKENS=8192
# OVOGO_MAX_CONTEXT_TOKENS=200000
# OVOGO_AUTO_COMPLETE=true
# OVOGO_REQUIRE_PLATFORM_VERIFY=false
# OVOGO_MAX_STRATEGY_CYCLES=12
# OVOGO_MAX_STRATEGY_ACTIONS=48
# OVOGO_MAX_CHEAP_ACTIONS=32
# OVOGO_MAX_NORMAL_ACTIONS=18
# OVOGO_MAX_EXPENSIVE_ACTIONS=6
# OVOGO_MAX_WORKFLOW_RUNS=12
# OVOGO_MAX_ONESHOT_RUNS=12
# OVOGO_MAX_HANDOFFS=6
# OVOGO_MAX_COST_UNITS=96
