{
  "name": "ovogogogo",
  "version": "0.1.0",
  "description": "Lightweight OpenAI-compatible autonomous agent base",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/bin/ovogogogo.js",
  "bin": {
    "ovogogogo": "./dist/bin/ovogogogo.js",
    "ovogogogo-ctf": "./dist/bin/ovogogogo-ctf.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/ovogogogo.js",
    "dev": "tsx bin/ovogogogo.ts",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run test",
    "lint": "eslint src/ bin/ tests/",
    "lint:fix": "eslint src/ bin/ --fix",
    "format": "prettier --write src/ bin/ tests/",
    "format:check": "prettier --check src/ bin/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "openai": "^4.77.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "oneshot/manifests",
    "oneshot/scripts",
    "src/knowledge",
    ".env.example",
    "README.md",
    "AUDIT.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6",
      "vite": ">=8.0.16 <9.0.0",
      "brace-expansion": ">=5.0.9"
    }
  }
}
